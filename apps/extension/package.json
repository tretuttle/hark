{
  "name": "@hark/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-icons.ts && node scripts/build-experiment.ts public && extension dev --browser zen --no-telemetry",
    "build": "node scripts/write-icons.ts && extension build --browser firefox --no-addon-lint --no-telemetry && node scripts/build-experiment.ts dist/firefox",
    "check:xpi": "node scripts/check-xpi.ts",
    "pack": "vp run build && node scripts/pack.ts && node scripts/check-xpi.ts",
    "screenshot:readme": "node scripts/screenshot-readme.ts",
    "screenshot:toolbar": "node scripts/screenshot-toolbar.ts",
    "test": "vp test run --config ../../vite.config.ts --dir .",
    "typecheck": "effect-tsgo tsrs --noEmit && effect-tsgo tsrs --noEmit -p experiment && effect-tsgo tsrs --noEmit -p experiment/tsconfig.test.json",
    "verify:browser": "node scripts/verify-browser.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@hark/export": "workspace:*",
    "@hark/har": "workspace:*",
    "@hark/recording": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@rspack/core": "2.2.3",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "acorn": "8.19.0",
    "ajv": "8.17.1",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.13",
    "djv": "2.1.4",
    "effect": "catalog:",
    "ejs": "3.1.10",
    "extension": "4.1.39",
    "fflate": "0.8.3",
    "greenlet": "1.1.0",
    "handlebars": "4.7.8",
    "js-yaml": "4.3.2",
    "jsonschema": "1.4.1",
    "kysely": "0.27.5",
    "libphonenumber-js": "1.12.15",
    "lightningcss": "1.33.0",
    "lit-html": "3.2.1",
    "lru-cache": "11.2.2",
    "marked": "15.0.12",
    "oxc-parser": "0.147.0",
    "pako": "2.1.0",
    "parse5": "8.1.1",
    "prismjs": "1.29.0",
    "saxes": "6.0.0",
    "sql.js": "1.12.0",
    "vite-plus": "catalog:",
    "vue": "3.5.43",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.8"
  }
}
